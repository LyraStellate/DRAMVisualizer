{
  "name": "dram_visualizer_web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh release",
    "build:wasm:dev": "bash scripts/build-wasm.sh dev",
    "dev": "npm run build:wasm:dev && vite",
    "build": "npm run build:wasm && tsc && vite build",
